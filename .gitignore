# ==================== Python ====================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ==================== 抓取产物 ====================
# 注意：data/dataset.json 的最新副本由云函数提交到独立的 data 分支，
# main 上这份只是历史副本，仅在 data 分支拉取失败时作回退用（见 .github/workflows/daily.yml）。
# 稳定后可自行 `git rm --cached data/dataset.json` 从 main 移除。
data/snapshot/
data/cache/

# ==================== 生成的站点 ====================
# site/ 由 CI 构建并通过 Pages 制品部署，不入库，避免每日提交撑大仓库
site/

# ==================== 云函数打包产物 ====================
# scf/dist/*.zip 由 scf/package.py 生成，本地上传到腾讯云即可，不入库
scf/dist/

# ==================== 一次性分析报告 ====================
# 项目早期人工分析导出的 HTML，仅本地留存，不属于可复现的工程产物
reports/

# ==================== 本地工具数据 ====================
# WorkBuddy 本地记忆与会话数据，不入库
.workbuddy/

# ==================== 本地环境与凭据 ====================
# Token 只走环境变量 / CI Secret / 本地 .env，严禁落到任何入库文件里
.env
.env.*
!.env.example
*.token
config/local.json
.mashangjia/

# ==================== 编辑器 / 系统 ====================
.vscode/
.idea/
.trae/
.DS_Store
Thumbs.db

# ==================== 日志 ====================
*.log

# ==================== 部署回执（含认领信息，绝不入库） ====================
deploy_out.json
deploy_err.log
msj_out.json
msj_err.log
live.html
live2.html
