# ============================================================================
# .env.example —— 本地环境变量模板
#
# 用法：复制为 .env 后按需填写；.env 已被 .gitignore 屏蔽，绝不会入库。
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# 优先级：进程已有的真实环境变量（如 CI Secret）> .env > config/config.json 默认值。
# 即：这里留空或删除某一行，程序就回退到 config/config.json 里的默认值；
#     GitHub Actions 不需要 .env，在 Settings → Secrets 配置同名变量即可。
#
# 语法：KEY=VALUE，支持 export 前缀与成对引号；# 开头为注释。
# ============================================================================


# ----------------------------------------------------------------------------
# 一、码上架发布凭据（https://mashangjia.com 控制台「API Token」页面生成）
#    只在本地发布时需要；不发布到码上架可整组留空。
#    警告：这里是全仓库唯一允许填写 Token 的地方，切勿写进 config.json 或其它文件。
# ----------------------------------------------------------------------------

# 登录 Token（以 MSJ- 开头）。publish.py 检测到后会自动先 `mashangjia login` 再部署。
MASHANGJIA_LOGIN_TOKEN=

# 部署口令（可选）。注意它与「登录 Token」不是同一种凭据，格式校验不同，不要混用。
MASHANGJIA_DEPLOY_TOKEN=


# ----------------------------------------------------------------------------
# 二、页面外链（fork 成你自己的项目后改成你的地址；留空则用 config.json 默认值）
#    会渲染到站点页头/页脚的链接上，下次运行 daily_update.py 时生效。
# ----------------------------------------------------------------------------

# 源代码仓库地址
AHUT_REPO_URL=https://github.com/caifugao110/ahut-recruitment-calendar

# GitHub Pages 在线地址
AHUT_PAGES_URL=https://caifugao110.github.io/ahut-recruitment-calendar/


# ----------------------------------------------------------------------------
# 三、码上架目标站点（fork 后改成你自己的站点；留空则用 config.json 默认值）
#    仅在 publish.py 发布到码上架时使用。
# ----------------------------------------------------------------------------

# 站点 slug（publish.py 用 `mashangjia deploy <slug> <zip>` 定向更新它，保证固定地址不变）
MASHANGJIA_SITE_SLUG=ahut-recruitment-calendar

# 站点固定访问地址；留空时由 config/config.json -> publish.site_url_pattern 按 slug 推导
MASHANGJIA_SITE_URL=https://ahut-recruitment-calendar.mashangjia.com/
